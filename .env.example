# ---- Cloud backend (server/) ----
PORT=8787

# ---- Alerts (optional) ----
# Leave blank to log alerts to the console instead of sending them.
SLACK_WEBHOOK_URL=
RESEND_API_KEY=
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=alerts@fleetview.app

# ---- Edge agent (agent/) ----
CLOUD_INGEST_URL=http://127.0.0.1:8787/ingest
POLL_STATUS_MS=10000
POLL_HISTORY_MS=30000
POLL_OBSTRUCTION_MS=300000

# Point a single real agent at a real dish instead of the simulator:
# DISH_ADDR=192.168.100.1:9200
# SITE_TOKEN=flv_xxxxxxxx
